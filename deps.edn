;; `resources` carries the shipped decision-core KIR that
;; `infra-utility-connect.kotoba-oracle` executes; it is on the default path
;; because production reads it, not just tests.
{:paths ["src" "test" "resources"]
 :deps
 {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.pprint"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.text"}
       ;; The KIR interpreter is a RUNTIME dependency: `kotoba-oracle` executes
  ;; `resources/infra_utility_connect/oracle/*.kir.edn` through it, so the
  ;; transition table in `src/**/utility_cell_core.kotoba` is what this actor
  ;; RUNS rather than what a test compares against. The COMPILER stays in the
  ;; `:kotoba-gen` alias -- it produced those artifacts and never reaches
  ;; production.
  ;;
  ;; Pinned to the kir the pinned compiler emits for. They have to match: KIR
  ;; is a versioned document, and an interpreter reading a shape its emitter
  ;; did not write is exactly the failure the artifact removes.
  io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.osaho"}}
 :aliases
 {;; Regenerate or verify the shipped KIR. `check` exits 1 on drift.
  ;;
  ;;   kbb -M:kotoba-gen
  ;;   kbb -M:kotoba-gen check
  ;;
  ;; `kotoba-lang/compiler` redirects at GitHub to `kotoba-lang/amu`. This pin
  ;; and the `kotoba-kir` pin above are a matched pair.
  :kotoba-gen
  {:extra-deps
   {io.github.kotoba-lang/compiler
    {:git/url "https://github.com/kotoba-lang/compiler.git"
     :git/sha "1644b326eefa0951a6343cee9aff88fe9ba745e2"}}
   ;; The compiler pin drags OLDER `io-multiformats` / `io-ipld` than the ones
   ;; newest-wins would pick; hold the pair the compiler was built against.
   :override-deps
   {io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.osaho"}
    io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.ioMultiformats"}
    io.github.kotoba-lang/io-ipld
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "325baa31020aa214bd17cb39e3803712f92f5a1a"
         :deps/root "lib/kotoba.ioIpld"}}
   :main-opts ["-m" "infra-utility-connect.kotoba-oracle-gen"]}

  ;; The standalone suite. Runs against the SHIPPED artifact and the
  ;; interpreter only -- the compiler is not on this classpath, so a green run
  ;; means the artifact agrees with the reference, never that the source and
  ;; the artifact agree. For that, `kbb -M:kotoba-gen check`.
  :test
  {:main-opts ["-e" "(load-file \"test/infra_utility_connect/test_runner.cljk\")"]}}}
