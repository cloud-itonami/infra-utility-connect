;; infra-utility-connect 電気 — meter_install cell (langgraph, WASM runtime)
;; ADR-2605250900 · Phase 1 scaffold
{:cell/id "meter_install"
 :cell/glyph "⚙️"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_meter_install"
 :cell/doc "Monitor meter installation progress from approved service requests. Query utility RPC for installation status; witness meter serial + calibration date via open API (G2 — IPFS-pin cert). Output: meterInstallationConfirmation (water/gas/electric meter IDs, calibration timestamps, provider attestation). Stays compute-only; no live dispatch until member signature."
 :cell/state-graph
 {:nodes [:query-water-meter :query-gas-meter :query-electric-meter :query-telecom :pin-certs :verify-calibration]
  :entry :query-water-meter
  :edges [[:query-water-meter :query-gas-meter] [:query-gas-meter :query-electric-meter]
          [:query-electric-meter :query-telecom] [:query-telecom :pin-certs]
          [:pin-certs :verify-calibration] [:verify-calibration :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G2" "G5" "G6" "G10"]
 :cell/kotoba
 {:reads [:provider-approval/id :provider-approval/approval-code]
  :writes [:meter-installation/id :meter-installation/meter-type :meter-installation/serial
           :meter-installation/calibration-date :meter-installation/ipfs-cert-cid
           :meter-installation/status]}}
