;; infra-utility-connect ガス — provider_approval cell (langgraph, WASM runtime)
;; ADR-2605250900 · Phase 1 scaffold
{:cell/id "provider_approval"
 :cell/glyph "⚡"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_provider_approval"
 :cell/doc "Poll utility company RPC endpoints for approval on service-request IDs (G3 — signature required). Water/gas/electric/telecom companies grant permission-to-connect via open-source query API. Output: approvalRecords (provider signature + approval code + legal SLA date). Stops at :intent — no actual RPC broadcast until member signature + settle.state :executed (G10/G9)."
 :cell/state-graph
 {:nodes [:poll-water :poll-gas :poll-electric :poll-telecom :aggregate-approvals]
  :entry :poll-water
  :edges [[:poll-water :poll-gas] [:poll-gas :poll-electric]
          [:poll-electric :poll-telecom] [:poll-telecom :aggregate-approvals]
          [:aggregate-approvals :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G3" "G5" "G6" "G10"]
 :cell/kotoba
 {:reads [:service-request/id :service-request/provider :service-request/state]
  :writes [:provider-approval/id :provider-approval/sig :provider-approval/approval-code
           :provider-approval/sla-date :provider-approval/status]}}
