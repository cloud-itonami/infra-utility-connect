;; infra-utility-connect 通信 — activation_test cell (langgraph, WASM runtime)
;; ADR-2605250900 · Phase 1 scaffold
{:cell/id "activation_test"
 :cell/glyph "✓"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_activation_test"
 :cell/doc "Final verification: query utility RPC for live service status (water flow / gas pressure / electric load / network connectivity). All services confirmed active + metered. Output: utilityActivationRecord (go/no-go, all 4 service confirmations, settlement intent). G5 enforces no SLA delays (activate within legal window). No member outlay required for utility themselves — only etzhayyim coordination fee (USDC + tithe)."
 :cell/state-graph
 {:nodes [:test-water-flow :test-gas-pressure :test-electric-load :test-telecom-connectivity :compute-settlement :finalize]
  :entry :test-water-flow
  :edges [[:test-water-flow :test-gas-pressure] [:test-gas-pressure :test-electric-load]
          [:test-electric-load :test-telecom-connectivity] [:test-telecom-connectivity :compute-settlement]
          [:compute-settlement :finalize] [:finalize :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G5" "G6" "G8" "G10"]
 :cell/kotoba
 {:reads [:meter-installation/id :meter-installation/status]
  :writes [:utility-activation/id :utility-activation/result :utility-activation/water-live
           :utility-activation/gas-live :utility-activation/electric-live :utility-activation/telecom-live
           :utility-activation/settlement :utility-activation/timestamp]}}
