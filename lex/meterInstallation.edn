;; com.etzhayyim.infrautilityconnect.meterInstallation — meter installation & calibration record
;; ADR-2605250900 · Phase 1 (infrastructure witness, G2 IPFS-pinned certs)
{:lexicon 1
 :id "com.etzhayyim.infrautilityconnect.meterInstallation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["installationId" "meterType" "meterSerial" "calibrationDate" "ipfsCertCid" "status"]
    :properties
    {:installationId   {:type "string" :description "unique meter installation record ID"}
     :meterType        {:type "string" :description "water|gas|electric|telecom (service type)"}
     :meterSerial      {:type "string" :description "meter manufacturer serial number"}
     :calibrationDate  {:type "string" :description "ISO-8601 calibration timestamp from utility"}
     :ipfsCertCid      {:type "string" :description "IPFS CID of meter certification document (G2)"}
     :providerAttest   {:type "string" :description "utility company signature on calibration"}
     :status           {:type "string" :description "pending|installed|calibrated|failed"}
     :failureReason    {:type "string" :description "if failed, reason from provider or installation tech"}}}}}}
