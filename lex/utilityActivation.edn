;; com.etzhayyim.infrautilityconnect.utilityActivation — utility service activation record
;; ADR-2605250900 · Phase 1 (final go-live confirmation + settlement intent)
{:lexicon 1
 :id "com.etzhayyim.infrautilityconnect.utilityActivation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["activationId" "result" "waterLive" "gasLive" "electricLive" "telecomLive" "settlement" "timestamp"]
    :properties
    {:activationId   {:type "string" :description "unique activation record ID"}
     :result         {:type "string" :description "pass (all 4 live) | partial (≥1 failed) | fail (all offline)"}
     :waterLive      {:type "boolean" :description "water service confirmed flowing"}
     :gasLive        {:type "boolean" :description "gas service confirmed pressurized"}
     :electricLive   {:type "boolean" :description "electric service confirmed loaded"}
     :telecomLive    {:type "boolean" :description "telecom service confirmed connected"}
     :failureNote    {:type "string" :description "if result != pass, failure description"}
     :settlement     {:type "string" :description "settlement intent (USDC + tithe), not broadcast until signed"}
     :timestamp      {:type "string" :description "ISO-8601 activation test completion time"}}}}}}
