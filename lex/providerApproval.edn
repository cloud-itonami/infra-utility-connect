;; com.etzhayyim.infrautilityconnect.providerApproval — utility provider approval record
;; ADR-2605250900 · Phase 1 (permission-to-connect from utility company)
{:lexicon 1
 :id "com.etzhayyim.infrautilityconnect.providerApproval"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["approvalId" "serviceRequestId" "providerSignature" "approvalCode" "slaDate" "state"]
    :properties
    {:approvalId        {:type "string" :description "unique approval record ID"}
     :serviceRequestId  {:type "string" :description "→ serviceRequest"}
     :providerSignature {:type "string" :description "utility company signature (did:web path or JWS)"}
     :approvalCode      {:type "string" :description "utility-issued approval code for connection"}
     :slaDate           {:type "string" :description "ISO-8601 legally required service activation date"}
     :state             {:type "string" :description "pending|approved|rejected"}
     :rejectReason      {:type "string" :description "if rejected, reason from provider API"}}}}}}
