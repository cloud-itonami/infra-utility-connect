;; infra-utility-connect 水道・ガス・電気・通信 — kotoba EAVT schema
;; ADR-2605250900 · utility activation state machine (service request → approval → meter → live)
;; All state is kotoba Datoms (no SQL/RisingWave/Cypher). G7 enforcement: no canonical builder.

[;; ───────────────────────────── :site/* — construction site reference ─────────────────────────────
 {:db/ident :site/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "site identifier (ref from tatekata construction project)"}
 {:db/ident :site/address
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "full postal address (PII encrypted → com.etzhayyim.encrypted.*)"}
 {:db/ident :site/coordinates
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "latitude,longitude (decimal, public)"}

 ;; ───────────────────────────── :mep-signoff/* — MEP (MEchanical, Electrical, Plumbing) handoff ─────────────────────────────
 {:db/ident :mep-signoff/site
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref → :site (construction ready)"}
 {:db/ident :mep-signoff/water
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "water infrastructure MEP-signed?"}
 {:db/ident :mep-signoff/gas
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "gas infrastructure MEP-signed?"}
 {:db/ident :mep-signoff/electric
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "electric infrastructure MEP-signed?"}
 {:db/ident :mep-signoff/telecom
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "telecom (network) infrastructure MEP-signed?"}
 {:db/ident :mep-signoff/timestamp
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ISO-8601 MEP completion time"}

 ;; ───────────────────────────── :service-request/* — utility service request (4 per site) ─────────────────────────────
 {:db/ident :service-request/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :service-request/provider
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":water | :gas | :electric | :telecom"}
 {:db/ident :service-request/site
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :service-request/state
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":pending | :submitted | :confirmed"}
 {:db/ident :service-request/timestamp
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "request creation time"}
 {:db/ident :service-request/provider-api-url
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "open-source utility RPC endpoint (G1 — no proprietary SDK)"}

 ;; ───────────────────────────── :provider-approval/* — utility company permission ─────────────────────────────
 {:db/ident :provider-approval/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :provider-approval/request
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref → :service-request"}
 {:db/ident :provider-approval/sig
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "utility company signature (did:web or JWS) — G3 enforcement"}
 {:db/ident :provider-approval/approval-code
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "utility-issued connection approval code"}
 {:db/ident :provider-approval/sla-date
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ISO-8601 legal SLA activation date (G5 enforces no delay past this)"}
 {:db/ident :provider-approval/status
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":pending | :approved | :rejected"}
 {:db/ident :provider-approval/reject-reason
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "reason if :rejected"}

 ;; ───────────────────────────── :meter-installation/* — meter installation witness ─────────────────────────────
 {:db/ident :meter-installation/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :meter-installation/approval
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref → :provider-approval"}
 {:db/ident :meter-installation/meter-type
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":water | :gas | :electric | :telecom"}
 {:db/ident :meter-installation/serial
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "meter manufacturer serial number"}
 {:db/ident :meter-installation/calibration-date
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ISO-8601 calibration timestamp"}
 {:db/ident :meter-installation/ipfs-cert-cid
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "IPFS CID of calibration certificate (G2)"}
 {:db/ident :meter-installation/provider-attest
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "utility company signature on calibration (G3)"}
 {:db/ident :meter-installation/status
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":pending | :installed | :calibrated | :failed"}
 {:db/ident :meter-installation/failure-reason
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "if :failed, reason from provider"}

 ;; ───────────────────────────── :utility-activation/* — go-live confirmation + settlement ─────────────────────────────
 {:db/ident :utility-activation/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :utility-activation/site
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref → :site (all utilities confirmed live)"}
 {:db/ident :utility-activation/result
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":pass (all 4 live) | :partial (≥1 failed) | :fail (all offline)"}
 {:db/ident :utility-activation/water-live
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one}
 {:db/ident :utility-activation/gas-live
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one}
 {:db/ident :utility-activation/electric-live
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one}
 {:db/ident :utility-activation/telecom-live
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one}
 {:db/ident :utility-activation/failure-note
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "if result != :pass, failure description"}
 {:db/ident :utility-activation/settlement
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref → :settlement (coordination fee intent, not broadcast yet)"}
 {:db/ident :utility-activation/timestamp
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ISO-8601 activation test completion time"}

 ;; ───────────────────────────── :settlement/* — USDC + TitheRouter intent (NOT broadcast; G8/G9) ─────────────────────────────
 {:db/ident :settlement/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :settlement/activation
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref → :utility-activation"}
 {:db/ident :settlement/rail
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":usdc-base-l2 (ERC-4337 smart-account via warifu; no fiat)"}
 {:db/ident :settlement/gross-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "USDC minor (6-dp) gross coordination fee"}
 {:db/ident :settlement/tithe-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "10% TitheRouter auto-split → Public Fund (G8)"}
 {:db/ident :settlement/coordinator-payout-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "net to coordinator (gross − tithe), USDC minor"}
 {:db/ident :settlement/tithe-router
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "TitheRouter contract ref (50-infra/etzhayyim-tithe-router)"}
 {:db/ident :settlement/state
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":intent (computed, NOT broadcast) | :executed (member-signed + operator-broadcast). R0 stops at :intent"}
 {:db/ident :settlement/buyer-sig-ref
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "member passkey/smart-account signature ref; platform holds no key (G9). absent ⇒ stays :intent"}

 ;; ───────────────────────────── :sbt/* — Adherent SBT eligibility (§3 / G2) ─────────────────────────────
 {:db/ident :sbt/holder-did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "DID of an Adherent SBT holder (member coordinator)"}
 {:db/ident :sbt/active
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "active Adherent SBT? required for coordination role"}]
