;; infra-utility-connect 水道・ガス・電気・通信 — actor manifest (Gen-3 kotoba-native)
;; Utility company coordination — water, gas, electric, telecom activation post-construction
;; ADR-2605250900 (R0 scaffold) · 2026-05-26
{:actor/id        "infra-utility-connect"
 :actor/glyph     "💧⚡"
 :actor/tier      :tier-b
 :actor/domain    "infra-utility-connect.etzhayyim.com"
 :actor/purpose   "Utility activation Tier-B actor — coordinates final connections (water, gas, electric, telecom) with service providers post-construction (tatekata handoff). Four-cell Pregel: service_request (mepSignoff + coords) → provider_approval (RPC to utility companies) → meter_install (calibration witness) → activation_test (all services live). Murakumo-only inference via KotobaLLM 127.0.0.1:4000. Settlement is USDC Base L2 + ERC-4337 + TitheRouter 10% (no Stripe/fiat). Compute-only R0; settlement stops at :intent. Member signatures required for real outward actions; platform holds no key."
 :actor/status    :r0
 :actor/adr       "2605250900"
 :actor/related   ["2605250900"]

 :actor/charter-rider
 {:rider/version "2.0"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1"  :gate/name "open-source-rpc-calls"    :gate/rule "All utility RPC calls open-source (no proprietary utility APIs; Google/utility-vendor SDKs prohibited)"}
  {:gate/id "G2"  :gate/name "meter-cert-ipfs-pinned"   :gate/rule "Meter certification documents IPFS-pinned; no centralized PDF storage"}
  {:gate/id "G3"  :gate/name "utility-provider-sig"     :gate/rule "Utility provider signature ≥1 per service (water/gas/electric/telecom); no unattested data"}
  {:gate/id "G5"  :gate/name "no-gatekeeping-sla"       :gate/rule "Services activated within legal SLA; no artificial delays or upsells"}
  {:gate/id "G6"  :gate/name "murakumo-only"            :gate/rule "Service-request interpretation (NLP on RPC responses) → KotobaLLM 127.0.0.1:4000; no RunPod/vendor LLM (ADR-2605215000)"}
  {:gate/id "G7"  :gate/name "kotoba-eavt-native"       :gate/rule "State is kotoba Datom (service request / approval / meter / activation); no SQL/RisingWave/Cypher"}
  {:gate/id "G8"  :gate/name "tithe-non-fiat"           :gate/rule "Settlement is USDC Base L2 + ERC-4337 + TitheRouter 10% auto-split; no Stripe/fiat (constitution §1.11)"}
  {:gate/id "G9"  :gate/name "no-server-key"            :gate/rule "Member/operator signs each settlement; platform holds no key (ADR-2605231525)"}
  {:gate/id "G10" :gate/name "consent-bound"            :gate/rule "Real outward RPC calls (service-request to utility company) stay gated; compute-only R0; settlement stops at :intent"}
  {:gate/id "G11" :gate/name "pii-encrypted"            :gate/rule "Utility customer PII (account number, address, phone) → com.etzhayyim.encrypted.* (ADR-2605181100)"}
  {:gate/id "G12" :gate/name "outage-logging"           :gate/rule "Service outages logged + disseminated (emergency transparency)"}]

 :actor/cells
 [{:cell/id "service_request"  :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "provider_approval" :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "meter_install"     :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "activation_test"   :cell/kind :langgraph :cell/runtime :wasm}]

 :actor/lex
 [{:lex/id "serviceRequest"}
  {:lex/id "providerApproval"}
  {:lex/id "meterInstallation"}
  {:lex/id "utilityActivation"}]
}
